[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "dominoise"]
	path = dominoise
	url = https://github.com/inseefrlab/dominoise
[submodule "melodi"]
	path = melodi
	url = https://github.com/inseefrlab/melodi
[submodule "rjdworkspace"]
	path = rjdworkspace
	url = https://github.com/inseefrlab/rjdworkspace
